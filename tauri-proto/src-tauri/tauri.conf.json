{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumiDMX-Tauri-Proto",
  "version": "0.1.0",
  "identifier": "com.lumidhx.tauri.proto",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node ../serve.js",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "LumiDMX Tauri Proto",
        "width": 900,
        "height": 650
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
